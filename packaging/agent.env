# Env vars for ci-webhook-codex-agent, loaded by the systemd unit.
# Fill these in, then: systemctl restart ci-webhook-codex-agent
# File mode is 0640 (root:ci-webhook-codex-agent) — keep it that way.
#
# No GitHub/GitLab token here: gh and glab hold their own credentials. As the
# service user (HOME=/var/lib/ci-webhook-codex-agent) run `gh auth login` and
# `glab auth login` once; Codex reuses them.

# GitHub webhook shared secret (must match the webhook on GitHub). REQUIRED.
GITHUB_WEBHOOK_SECRET=

# Internal GitLab base URL (points glab at the right instance). REQUIRED.
GITLAB_HOST=https://gitlab.internal.corp

# Codex model auth (whatever your codex install expects), e.g.:
# OPENAI_API_KEY=
