# Env vars consumed via ${VAR} expansion in config.yaml.
# Copy to .env and fill in. Do NOT commit .env.
#
# There is no GitHub or GitLab token here on purpose: gh and glab hold their own
# credentials. Run `gh auth login` and `glab auth login` once and Codex reuses
# them. The only secret below is the webhook secret the agent verifies itself.

# GitHub webhook shared secret (must match the webhook config on GitHub).
# OPTIONAL: leave unset and the agent generates one on first run, persisting it
# at <codex.workdir>/.webhook-secret. `server setup-webhook` uses that same
# secret when it registers the webhook, so you only need to set this to pin a
# specific value (e.g. to match a webhook created by hand).
GITHUB_WEBHOOK_SECRET=

# Externally reachable base URL of this service (scheme + host). Used by
# `server setup-webhook` as the webhook delivery target (server.path appended).
PUBLIC_URL=https://ci.example.com

# Optional CLI conveniences (equivalent to the --config / --repo flags), so you
# don't have to pass them each time:
# CI_WEBHOOK_CONFIG=config.yaml
# GITHUB_REPO=owner/repo

# Internal GitLab base URL. Exported into the Codex child process as GITLAB_HOST
# so glab targets the right instance for repo-less commands.
GITLAB_HOST=https://gitlab.internal.corp

# Codex model auth (whatever your codex install expects, e.g. an API key).
# OPENAI_API_KEY=sk-...
