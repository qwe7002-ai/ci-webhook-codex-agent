# Secrets consumed via ${VAR} expansion in config.yaml and by glab (through Codex).
# Copy to .env and fill in. Do NOT commit .env.

# GitHub webhook shared secret (must match the webhook config on GitHub).
GITHUB_WEBHOOK_SECRET=change-me

# GitHub token (repo scope) for gh: PR reviews + fetching PR diffs.
# Required when the pull_request event is enabled. Exported to Codex as GH_TOKEN.
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Internal GitLab connection. GITLAB_HOST + GITLAB_TOKEN are also exported into
# the Codex child process so glab authenticates non-interactively.
GITLAB_HOST=https://gitlab.internal.corp
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Codex model auth (whatever your codex install expects, e.g. an API key).
# OPENAI_API_KEY=sk-...
